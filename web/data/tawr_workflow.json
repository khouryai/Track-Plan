{
  "_comment": "Who may do what to a TAWR, and from which status. Read by web/js/tawr.js (what the screen offers) and by server.py (what it allows). Change it here and both follow. A request's files change where its fields may (edit); anybody in comment may say something on any request.",
  "roles": {
    "requester": "Requester",
    "manager": "Track Allocation Manager",
    "viewer": "Viewer"
  },
  "statuses": {
    "draft": "Draft",
    "submitted": "Submitted",
    "approved": "Approved",
    "rejected": "Rejected",
    "denied": "Denied by BART",
    "cancelled": "Cancelled",
    "superseded": "Superseded",
    "consolidated": "Consolidated"
  },
  "live": ["draft", "submitted", "approved", "rejected"],
  "actions": {
    "submit": { "from": ["draft"], "to": "submitted", "roles": ["requester", "manager"], "label": "Submit for approval", "unblocked": true },
    "withdraw": { "from": ["submitted"], "to": "draft", "roles": ["requester", "manager"], "label": "Withdraw" },
    "approve": { "from": ["submitted"], "to": "approved", "roles": ["manager"], "label": "Approve", "unblocked": true },
    "reject": { "from": ["submitted"], "to": "rejected", "roles": ["manager"], "label": "Reject", "note": true },
    "reopen": { "from": ["rejected", "denied", "cancelled"], "to": "draft", "roles": ["requester", "manager"], "label": "Reopen as draft" },
    "deny": { "from": ["approved"], "to": "denied", "roles": ["requester", "manager"], "label": "BART denied it", "note": true },
    "cancel": { "from": ["approved"], "to": "cancelled", "roles": ["requester", "manager"], "label": "Cancel and release the track", "note": true },
    "revise": { "from": ["approved"], "to": "superseded", "roles": ["requester", "manager"], "label": "Revise", "creates": "draft" },
    "discard": { "from": ["draft", "rejected"], "to": null, "roles": ["requester", "manager"], "label": "Discard" },
    "consolidate": { "from": ["draft", "submitted"], "to": "consolidated", "roles": ["manager"], "label": "Consolidate" },
    "split": { "from": ["draft", "submitted", "rejected"], "to": null, "roles": ["manager"], "label": "Split back up" }
  },
  "records": {
    "bart": { "on": ["approved", "cancelled"], "roles": ["requester", "manager"], "label": "Sent to BART, and BART's answer" },
    "access": { "on": ["approved"], "roles": ["requester", "manager"], "label": "Whether the access was used" }
  },
  "edit": {
    "draft": ["requester", "manager"],
    "submitted": ["manager"]
  },
  "comment": ["requester", "manager"],
  "write": ["requester", "manager"]
}
